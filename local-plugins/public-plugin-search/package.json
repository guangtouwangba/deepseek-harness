{
  "name": "@local/dsh-public-plugin-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Search public npm packages for installable DSH plugin bundles without installing them.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "search.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.zh.md"],
  "scripts": { "test": "node --test tests/*.test.js" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
